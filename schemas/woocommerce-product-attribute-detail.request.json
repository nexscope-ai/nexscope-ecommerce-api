{
  "type": "object",
  "required": [
    "storeUrl",
    "attributeId"
  ],
  "additionalProperties": false,
  "properties": {
    "storeUrl": {
      "type": "string",
      "description": "Public HTTPS store root or WordPress installation path.",
      "maxLength": 2048
    },
    "attributeId": {
      "type": "string",
      "description": "Store-scoped attribute ID.",
      "pattern": "^[1-9][0-9]{0,18}$"
    }
  }
}
