{
  "oneOf": [
    {
      "required": [
        "imageUrl"
      ]
    },
    {
      "required": [
        "imageBase64"
      ]
    }
  ],
  "properties": {
    "imageUrl": {
      "maxLength": 4096,
      "format": "uri",
      "pattern": "^https?://",
      "type": "string",
      "minLength": 8
    },
    "imageBase64": {
      "maxLength": 20971520,
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "minLength": 16
    },
    "title": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 1
    },
    "topK": {
      "type": "integer",
      "default": 20,
      "maximum": 200,
      "minimum": 1
    },
    "regions": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2}$"
      },
      "uniqueItems": true
    },
    "jurisdictionCodes": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,8}$"
      },
      "uniqueItems": true
    },
    "topLoc": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "locarnoClasses": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}-[0-9]{2}$"
      },
      "uniqueItems": true
    },
    "patentStatus": {
      "items": {
        "type": "integer",
        "enum": [
          0,
          1
        ]
      },
      "maxItems": 2,
      "minItems": 1,
      "uniqueItems": true,
      "type": "array"
    }
  },
  "additionalProperties": false,
  "type": "object"
}
