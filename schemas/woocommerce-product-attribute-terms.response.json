{
  "required": [
    "code",
    "msg",
    "data",
    "ts",
    "time",
    "cost",
    "traceId"
  ],
  "type": "object",
  "properties": {
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "storeUrl": {
              "type": "string",
              "description": "Normalized store identity.",
              "example": "https://example.com"
            },
            "fetchedAt": {
              "type": "string",
              "description": "Fetch time in epoch milliseconds; preserved on cache hits.",
              "example": "1792972800000"
            },
            "cacheHit": {
              "type": "boolean",
              "description": "Whether the response was served from the anonymous 60-second cache.",
              "example": false
            },
            "terms": {
              "type": "array",
              "description": "Normalized public data. Missing optional values are null or empty strings.",
              "example": [],
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Store-scoped ID string.",
                    "example": "1"
                  },
                  "name": {
                    "type": "string",
                    "description": "Plain text name.",
                    "example": "Color"
                  },
                  "slug": {
                    "type": "string",
                    "description": "Plain text or public URL; empty when unavailable. Images are not fetched.",
                    "example": "blue"
                  },
                  "description": {
                    "type": "string",
                    "description": "Plain text or public URL; empty when unavailable. Images are not fetched.",
                    "example": ""
                  },
                  "imageUrl": {
                    "type": "string",
                    "description": "Plain text or public URL; empty when unavailable. Images are not fetched.",
                    "example": ""
                  },
                  "url": {
                    "type": "string",
                    "description": "Plain text or public URL; empty when unavailable. Images are not fetched.",
                    "example": ""
                  },
                  "parentId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Parent ID; 0 is a root term, null means unavailable.",
                        "example": "0"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "count": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "description": "Associated product count, null when unavailable.",
                        "example": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "name",
                  "slug",
                  "description",
                  "imageUrl",
                  "url"
                ]
              }
            }
          },
          "required": [
            "storeUrl",
            "fetchedAt",
            "cacheHit",
            "terms"
          ],
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "description": "0 means accepted or successful; nonzero is a platform error.",
      "type": "integer"
    },
    "msg": {
      "type": [
        "string",
        "null"
      ]
    },
    "ts": {
      "description": "Epoch milliseconds.",
      "type": "string"
    },
    "time": {
      "description": "Server local time: yyyy-MM-dd HH:mm:ss.",
      "type": "string"
    },
    "cost": {
      "description": "Elapsed milliseconds, never credits; -1 outside web requests.",
      "type": "string"
    },
    "traceId": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
