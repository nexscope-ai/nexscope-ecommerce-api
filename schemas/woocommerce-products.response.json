                            "example": null
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "regularPriceMinor": {
                        "anyOf": [
                          {
                            "type": "string",
                            "description": "Exact amount string; null when unavailable. Minor suffix denotes original smallest-unit amount.",
                            "example": null
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "salePriceMinor": {
                        "anyOf": [
                          {
                            "type": "string",
                            "description": "Exact amount string; null when unavailable. Minor suffix denotes original smallest-unit amount.",
                            "example": null
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "minPriceMinor": {
                        "anyOf": [
                          {
                            "type": "string",
                            "description": "Exact amount string; null when unavailable. Minor suffix denotes original smallest-unit amount.",
                            "example": null
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "maxPriceMinor": {
                        "anyOf": [
                          {
                            "type": "string",
                            "description": "Exact amount string; null when unavailable. Minor suffix denotes original smallest-unit amount.",
                            "example": null
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "minPrice": {
                        "anyOf": [
                          {
                            "type": "string",
                            "description": "Exact amount string; null when unavailable. Minor suffix denotes original smallest-unit amount.",
                            "example": null
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "maxPrice": {
                        "anyOf": [
                          {
                            "type": "string",
                            "description": "Exact amount string; null when unavailable. Minor suffix denotes original smallest-unit amount.",
                            "example": null
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "currency",
                      "minorUnit"
                    ]
                  },
                  "images": {
                    "type": "array",
                    "description": "Public image URLs; images are not fetched by this API.",
                    "example": [],
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "description": "Image URL.",
                          "example": "https://example.com/image.jpg"
                        },
                        "alt": {
                          "type": "string",
                          "description": "Plain text alternative label.",
                          "example": "Shirt"
                        }
                      },
                      "required": [
                        "url",
                        "alt"
                      ]
                    }
                  }
                },
                "required": [
                  "prices",
                  "images"
                ]
              }
            },
            "pageNum": {
              "type": "integer",
              "description": "Pagination metadata; totals are null when the store omits headers.",
              "example": 1
            },
            "pageSize": {
              "type": "integer",
              "description": "Pagination metadata; totals are null when the store omits headers.",
              "example": 20
            },
            "total": {
              "anyOf": [
                {
                  "type": "integer",
                  "description": "Pagination metadata; totals are null when the store omits headers.",
                  "example": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "totalPages": {
              "anyOf": [
                {
