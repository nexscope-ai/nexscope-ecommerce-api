{
  "required": [
    "code",
    "msg",
    "data",
    "ts",
    "time",
    "cost",
    "traceId"
  ],
  "type": "object",
  "properties": {
    "data": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "storeUrl": {
              "type": "string",
              "description": "Normalized store identity.",
              "example": "https://example.com"
            },
            "fetchedAt": {
              "type": "string",
              "description": "Fetch time in epoch milliseconds, not the product modification time.",
              "example": "1792972800000"
            },
            "cacheHit": {
              "type": "boolean",
              "description": "Whether the response was served from the anonymous 60-second cache.",
              "example": false
            },
            "products": {
              "type": "array",
              "description": "Normalized public products.",
              "example": [],
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Plain text or public product identifier.",
                        "example": "34"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "parentId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Store value; null when unavailable.",
                        "example": null
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Store value; null when unavailable.",
                        "example": "simple"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "name": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Plain text or public product identifier.",
                        "example": "Cotton Shirt"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sku": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Plain text or public product identifier.",
                        "example": "SHIRT-34"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Plain text or public product identifier.",
                        "example": "https://example.com/product/shirt"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "description": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Plain text or public product identifier.",
                        "example": "Cotton shirt."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "shortDescription": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Plain text or public product identifier.",
                        "example": "Cotton shirt."
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "variation": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "Plain text or public product identifier.",
                        "example": ""
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "isInStock": {
                    "anyOf": [
                      {
                        "type": "boolean",
                        "description": "Store value, null when unavailable.",
                        "example": true
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "isPasswordProtected": {
                    "anyOf": [
                      {
                        "type": "boolean",
                        "description": "Store value, null when unavailable.",
                        "example": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "stockQuantity": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "description": "Always null: public Store API does not expose exact inventory.",
                        "example": null
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "prices": {
                    "type": "object",
